msgstr "يساعدك Embellish على إدارة خطوط نيرد على نظامك"

#: src/application.vala:61
msgid "translator-credits"
msgstr "روني نيسان https://github.com/ronniedroid/"

#: src/application.vala:69
msgid "Concessio"
msgstr "كونسيسيو"

#: src/application.vala:69
msgid "Understand file permissions"
msgstr "فهم أذونات الملفات"

#: src/application.vala:70
msgid "Sitra"
msgstr "سطرا"

#: src/application.vala:70
