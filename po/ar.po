#: data/io.github.getnf.embellish.metainfo.xml.in:32
msgid ""
"User-friendly application designed for managing Nerd Fonts on your system. "
"With a sleek GTK4 user interface enhanced by libadwaita, Embellish provides "
"a seamless experience for installing, uninstalling and updating of Nerd "
"Fonts."
msgstr ""
"تطبيق سهل الاستخدام مصمم لإدارة خطوط نيرد (Nerd Fonts) على نظامك. بفضل واجهة "
"مستخدم GTK4 الأنيقة والمدعومة بـ libadwaita، يوفر أيمبيليش تجربة سلسة لتثبيت "
"وإلغاء تثبيت وتحديث خطوط نيرد."

#: data/io.github.getnf.embellish.metainfo.xml.in:38
msgid "List all available Nerd Fonts"
msgstr "عرض كافة الخطوط المتاحة"

#: data/io.github.getnf.embellish.metainfo.xml.in:39
msgid "Download and install a Font"
msgstr "تنزيل وتثبيت خط"

#: data/io.github.getnf.embellish.metainfo.xml.in:40
msgid "Uninstall an installed Font"
msgstr "إلغاء تثبيت خط مثبت"

#: data/io.github.getnf.embellish.metainfo.xml.in:41
msgid "Update an installed font"
msgstr "تحديث خط مثبت"

#: data/io.github.getnf.embellish.metainfo.xml.in:42
msgid "preview fonts"
msgstr "معاينة الخطوط"

#: data/io.github.getnf.embellish.metainfo.xml.in:43
msgid "Browse icons (icon's cheat sheet)"
msgstr "تصفح الأيقونات (ورقة الغش للأيقونات)"

#: data/io.github.getnf.embellish.metainfo.xml.in:44 src/shortcuts-dialog.blp:7
#: src/window.blp:87 src/window.blp:106 src/window.vala:72
msgid "Search fonts"
msgstr "البحث عن الخطوط"

#: data/io.github.getnf.embellish.metainfo.xml.in:45
msgid "Read font's license(s)"
msgstr "قراءة تراخيص الخط"

#: data/io.github.getnf.embellish.metainfo.xml.in:46
msgid "Add custom fonts"
msgstr "إضافة خطوط مخصصة"

#: data/io.github.getnf.embellish.metainfo.xml.in:47
msgid "Import and export custom fonts"
msgstr "استيراد وتصدير خطوط مخصصة"

#: data/io.github.getnf.embellish.metainfo.xml.in:56
msgid ""
"Main page showing a list of custon fonts and installed and available nerd "
"fonts"
msgstr "الصفحة الرئيسية تعرض قائمة بالخطوط المخصصة وخطوط نيرد المثبتة والمتاحة"

#: data/io.github.getnf.embellish.metainfo.xml.in:60
msgid "Icons page showing all the avilable nerd fonts icons"
msgstr "صفحة الأيقونات التي تعرض جميع أيقونات خطوط نيرد المتاحة"

#: data/io.github.getnf.embellish.metainfo.xml.in:65
msgid "Previewing JetBrains Mono font using JavaScript code"
msgstr "عرض خط JetBrains Mono باستخدام كود جافاسكريبت"

#: data/io.github.getnf.embellish.metainfo.xml.in:69
msgid "Showcasing the import dialog with Maple Mono fonts data"
msgstr "عرض مربع حوار الاستيراد مع بيانات خطوط Maple Mono"

#: data/io.github.getnf.embellish.metainfo.xml.in:74
msgid "Search page, showcasing search functionality"
msgstr "صفحة البحث، لاستعراض وظيفة البحث"

