msgstr "Ronnie Nissan"

#: data/io.github.getnf.embellish.metainfo.xml.in:36
msgid ""
"User-friendly application designed for managing Nerd Fonts on your system. "
"With a sleek GTK4 user interface enhanced by libadwaita, Embellish provides "
"a seamless experience for installing, uninstalling and updating of Nerd "
"Fonts."
msgstr "システム上のNerd Fontsを管理するために作られたユーザーフレンドリーなアプリです。libadwaitaで強化されたスタイリッシュなGTK4のユーザーインターフェイスで、EmbellishはNerd Fontsのインストール、アンインストール、アップデートをシームレスに行えます。"

#: data/io.github.getnf.embellish.metainfo.xml.in:42
msgid "List all available Nerd Fonts"
msgstr "利用可能なすべてのNerd Fontsを一覧表示"

#: data/io.github.getnf.embellish.metainfo.xml.in:43
msgid "Download and install a Font"
msgstr "フォントをダウンロードしてインストール"

#: data/io.github.getnf.embellish.metainfo.xml.in:44
msgid "Uninstall an installed Font"
msgstr "インストール済みのフォントをアンインストール"

#: data/io.github.getnf.embellish.metainfo.xml.in:45
msgid "preview fonts"
msgstr "フォントをプレビュー"

#: data/io.github.getnf.embellish.metainfo.xml.in:46
msgid "Browse icons (icon's cheat sheet)"
msgstr "アイコンを閲覧（アイコン早見表）"

#: data/io.github.getnf.embellish.metainfo.xml.in:47 src/shortcuts-dialog.blp:7
#: src/window.blp:96 src/window.blp:115 src/window.vala:72
msgid "Search fonts"
msgstr "フォントを検索"

#: data/io.github.getnf.embellish.metainfo.xml.in:48
msgid "Read font's license(s)"
msgstr "フォントのライセンスを確認"

#: data/io.github.getnf.embellish.metainfo.xml.in:49
msgid "Add custom fonts"
msgstr "カスタムフォントを追加"

#: data/io.github.getnf.embellish.metainfo.xml.in:50
msgid "Import and export custom fonts"
msgstr "カスタムフォントのインポートとエクスポート"

#: data/io.github.getnf.embellish.metainfo.xml.in:59
msgid ""
"Main page showing a list of custon fonts and installed and available nerd "
"fonts"
msgstr "カスタムフォントやインストール済み・利用可能なNerd Fontsの一覧を表示するメインページ"

#: data/io.github.getnf.embellish.metainfo.xml.in:63
msgid "Icons page showing all the available nerd fonts icons"
msgstr "利用可能なすべてのNerd Fontsのアイコンを表示するアイコンページ"

#: data/io.github.getnf.embellish.metainfo.xml.in:68
msgid "Previewing JetBrains Mono font using JavaScript code"
msgstr "JavaScriptのコードでJetBrains Monoフォントをプレビュー"

#: data/io.github.getnf.embellish.metainfo.xml.in:72
msgid "Showcasing the import dialog with Maple Mono fonts data"
msgstr "Maple Monoフォントのデータでインポートダイアログを表示"

#: data/io.github.getnf.embellish.metainfo.xml.in:77
msgid "Search page, showcasing search functionality"
msgstr "検索ページ"

#: src/add-font-dialog.blp:5 src/window.blp:176
msgid "Add a custom font"
msgstr "カスタムフォントを追加"

#: src/add-font-dialog.blp:16
msgid "Add"
msgstr "追加"

#: src/add-font-dialog.blp:37
msgid "Name"
msgstr "名前"

#: src/add-font-dialog.blp:41
msgid "Description"
msgstr "説明"

#: src/add-font-dialog.blp:45
msgid "URL"
msgstr "URL"

#: src/application.vala:55
msgid "Embellish helps you manage Nerd Fonts on your system"
msgstr "Embellishでシステム上のNerd Fontsを管理できます"

